# Credenciales de PRUEBA de MercadoPago. Copiar a .env y completar.
# Nunca poner credenciales de producción acá ni versionar el .env.

# Access token de prueba de la aplicación.
# El prefijo depende del producto: APP_USR- (Checkout Pro, Orders, Point, QR) o
# TEST- (Checkout API, Bricks, suscripciones). Ambos son válidos.
MP_ACCESS_TOKEN=

# Secreto para verificar la firma de los avisos (panel de MP > Webhooks)
MP_WEBHOOK_SECRET=

# URL pública HTTPS que MercadoPago puede alcanzar (túnel o despliegue).
# MercadoPago no puede llamar a localhost.
MP_URL_PUBLICA=

# Horas de vigencia de cada link antes de expirar (opcional, por omisión 24)
MP_HORAS_VIGENCIA=24

# 1 cuando se usan credenciales de prueba: el checkout debe ir por el dominio sandbox
MP_SANDBOX=1
